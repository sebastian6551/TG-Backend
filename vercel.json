{
    "rewrites": [
        {
            "source": "/static",
            "destination": "/static"
        },
        {
            "source": "/(.*)",
            "destination": "api/wsgi.py"
        }
    ],
    "functions": {
        "api/wsgi.py": {
          "runtime": "vercel-python-gis@1.0.0"
        }
      }
}