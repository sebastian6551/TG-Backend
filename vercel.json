{
    "builds": [
        {
            "src": "backend/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb",
                "runtime": "vercel-python-gis@1.0.0"
            }
        },
        {
            "src": "build_files.sh",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "staticfiles"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/static",
            "destination": "/static"
        },
        {
            "source": "/(.*)",
            "destination": "backend/wsgi.py"
        }
    ]
}